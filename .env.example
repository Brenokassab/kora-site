# Copie estes nomes para "Environment Variables" na Vercel.
# Nunca publique os valores reais no GitHub.

# ---------- Obrigatório: IA ----------
# Chave da API do Claude (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=
# Modelo (opcional). Padrão: claude-haiku-4-5-20251001 (rápido e barato)
KORA_MODEL=

# ---------- Seu site de vendas (vitrine) ----------
# true = o chat do site atende como loja, imobiliária, restaurante, clínica ou serviços (abas da demonstração).
# Na instalação de um cliente, deixe vazio: a Kora usa config/empresa.json.
KORA_DEMO=true
# Senha do painel de leads e cadastros (/admin)
ADMIN_KEY=
# kora = o WhatsApp configurado é o SEU número de vendas (a Kora vende a Kora). Vazio no número de um cliente.
KORA_WHATSAPP_PERFIL=

# ---------- Opcional: Google Agenda ----------
# E-mail da conta de serviço (termina em iam.gserviceaccount.com)
GOOGLE_CLIENT_EMAIL=
# Chave privada da conta de serviço, entre aspas, com \n no lugar das quebras de linha
GOOGLE_PRIVATE_KEY=
# ID da agenda da empresa (Configurações da agenda → Integrar agenda → ID da agenda)
GOOGLE_CALENDAR_ID=

# ---------- Opcional: WhatsApp oficial (Meta Cloud API) ----------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Senha que você inventa e repete no painel da Meta ao cadastrar o webhook
WHATSAPP_VERIFY_TOKEN=
# App Secret do app da Meta (Configurações do app → Básico)
WHATSAPP_APP_SECRET=
# Número que recebe os avisos de agendamento, pedidos de atendimento e urgências (só números, com 55 e DDD)
ALERT_WHATSAPP=

# ---------- Opcional: memória das conversas do WhatsApp ----------
# Banco Redis gratuito em upstash.com (REST URL e REST Token)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
